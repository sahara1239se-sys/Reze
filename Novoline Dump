## 3. HTTP Layer
-- pickRequest() → syn.request / http_request / request / fluxus / http
-- mirrorsOf() expands GitHub raw → jsDelivr + raw mirrors
-- _nvL._nvHttpGet(urls, opts) with retries + body validation

## 4. Spotify Module (key surface)
SPOTIFY_REDIRECT = "http://127.0.0.1:8888/callback"
SCOPES = "user-read-playback-state user-modify-playback-state ..."

SP = {
    file = "Novoline/spotify.json",
    cfg = {}, st = {}, art = {}, queueList = {},
    redirect = SPOTIFY_REDIRECT,
    dashboard = "https://developer.spotify.com/dashboard"
}

-- SP.sha256, SP.b64url → PKCE
-- SP.load / SP.save
-- SP.connected / SP.refresh / SP.finish (paste callback URL)
-- SP.call(method, path) → Spotify Web API
-- SP.poll → currently playing + queue
-- SP.toggle / play / pause / seek / next / prev
-- SP.setSource(true/false) switches active music source

## 5. Apple Music Bridge
-- External helper script (osascript loop writing state.json)
-- AM.send("play"/"pause"/...) via cmd.txt
-- AM.position / AM.st for progress
-- Notifies user if helper is not running

## 6. Local + SoundCloud
-- Same player UI
-- Source switching stops previous backend and updates _nvL.musicSource

## 7. Theme / Tint
-- Music cover dominant color can drive global UI tint (_nv_setTint)
-- Themes: Modern / Fluent + custom wallpaper

